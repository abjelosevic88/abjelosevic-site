---
import Icons from './Icons.astro';
import { profile } from '../data/site';
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="section" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="contact reveal">
      <div>
        <span class="eyebrow">Contact</span>
        <h2 id="contact-title">Let’s talk</h2>
        <p>
          Open to senior engineering and technical leadership roles, AI system design, and collaboration on self-hosted
          software. The fastest way to reach me is email.
        </p>
      </div>
      <div class="contact__links">
        <a class="btn btn--primary" href={`mailto:${profile.email}`}>
          <Icons name="mail" />
          {profile.email}
        </a>
        <a class="btn" href={profile.github} target="_blank" rel="noopener">
          <Icons name="github" />
          github.com/abjelosevic88
        </a>
        <a class="btn" href={`${base}${profile.cv}`} download>
          <Icons name="file" />
          Download CV (PDF)
        </a>
      </div>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="container footer__inner">
    <span>© {year} {profile.name}</span>
    <span>{profile.location}</span>
    <a href="https://pockethomelab.com/" target="_blank" rel="noopener">pockethomelab.com</a>
  </div>
</footer>

<style>
  .contact {
    display: grid;
    gap: 1.75rem;
    padding: clamp(1.75rem, 4vw, 3rem);
    border-radius: calc(var(--radius) + 6px);
    border: 1px solid var(--border);
    background:
      radial-gradient(70% 90% at 0% 0%, var(--glow-1), transparent 70%),
      radial-gradient(50% 70% at 100% 100%, var(--glow-2), transparent 70%),
      var(--bg-elev);
  }

  .contact h2 {
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    margin: 0.5rem 0 0.75rem;
  }

  .contact p {
    color: var(--text-muted);
    max-width: 52ch;
  }

  .contact__links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .contact__links .btn {
    max-width: 100%;
    overflow-wrap: anywhere;
    line-height: 1.3;
  }

  .footer {
    border-top: 1px solid var(--border);
    padding-block: 1.5rem;
    font-size: 0.85rem;
    color: var(--text-faint);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }

  .footer a {
    color: var(--text-muted);
  }

  @media (min-width: 820px) {
    .contact {
      grid-template-columns: 1.3fr 1fr;
      align-items: center;
    }

    .contact__links {
      align-items: flex-end;
    }
  }
</style>
