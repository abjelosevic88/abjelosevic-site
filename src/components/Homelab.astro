---
import Icons from './Icons.astro';
import {
  pocketHomelab,
  pocketCategories,
  pocketAppCount,
  pocketSite,
  ecosystem,
  nativeApps,
  raycast,
  sharedTraits,
  otherRepos,
} from '../data/site';
---

<section class="section" id="homelab" aria-labelledby="homelab-title">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Side project turned product</span>
      <h2 id="homelab-title">Pocket Homelab</h2>
      <p>
        A native app for people who run their own servers, plus {pocketAppCount} self-hosted apps behind one sign-in. Everything
        talks directly to your services over your own network.
      </p>
    </div>

    <div class="feature reveal">
      <div class="feature__body">
        <p class="feature__tagline">{pocketHomelab.tagline}</p>
        <h3>{pocketHomelab.name} for iOS and macOS</h3>
        <p class="feature__summary">{pocketHomelab.summary}</p>
        <ul class="feature__list">
          {pocketHomelab.highlights.map((h) => <li>{h}</li>)}
        </ul>
        <div class="feature__footer">
          <div class="tags">
            {pocketHomelab.platforms.map((p) => <span class="chip chip--accent">{p}</span>)}
          </div>
          <a class="btn btn--primary" href={pocketHomelab.url} target="_blank" rel="noopener">
            pockethomelab.com
            <Icons name="external" />
          </a>
        </div>
      </div>
      <div class="feature__aside">
        <p class="feature__aside-title">What every Pocket app ships with</p>
        <ul>
          {sharedTraits.map((t) => <li>{t}</li>)}
        </ul>
      </div>
    </div>

    <h3 class="sub-head reveal">The ecosystem</h3>
    <p class="sub-lede reveal">What ties the apps together, and where they run.</p>

    <div class="grid grid--2 eco">
      {
        ecosystem.map((e) => (
          <a class="card reveal" href={e.url} target="_blank" rel="noopener">
            <h3>{e.name}</h3>
            <p>{e.summary}</p>
            {e.name === 'Native companions' && (
              <ul class="native">
                {nativeApps.map((n) => (
                  <li>
                    <strong>{n.name}</strong>
                    <span class="native__platforms">{n.platforms.join(' · ')}</span>
                  </li>
                ))}
              </ul>
            )}
          </a>
        ))
      }
    </div>

    <h3 class="sub-head reveal" id="pocket-apps">The self-hosted suite: {pocketAppCount} apps</h3>
    <p class="sub-lede reveal">
      Open-source replacements for cloud services. One Go binary, one SQLite file, one volume each, MIT licensed, with
      companion views in the app. <a href={`${pocketSite}/apps`} target="_blank" rel="noopener">Full catalogue on pockethomelab.com</a>.
    </p>

    <div class="suite">
      {
        pocketCategories.map((c, i) => (
          <details class="cat reveal" open={i === 0}>
            <summary>
              <span class="cat__name">{c.name}</span>
              <span class="cat__count">{c.apps.length}</span>
              <span class="cat__desc">{c.description}</span>
            </summary>
            <ul class="apps">
              {c.apps.map((a) => (
                <li>
                  <a href={`${pocketSite}/apps/${a.slug}`} target="_blank" rel="noopener">
                    <span class="app__name">{a.name}</span>
                    <span class="app__summary">{a.summary}</span>
                    {a.replaces.length > 0 && <span class="app__instead">instead of {a.replaces.join(', ')}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ))
      }
    </div>

    <h3 class="sub-head reveal">Also built</h3>
    <div class="grid grid--3">
      <a class="card card--wide reveal" href={raycast.url} target="_blank" rel="noopener">
        <div class="card__top">
          <h3>{raycast.name}</h3>
          <span class="card__repo">
            <Icons name="github" />
            {raycast.repo}
          </span>
        </div>
        <p class="card__summary">{raycast.summary}</p>
        <p>{raycast.detail}</p>
        <div class="tags">
          {raycast.tags.map((t) => <span class="chip">{t}</span>)}
        </div>
      </a>
    </div>

    <div class="more reveal">
      <span class="more__label">Also on GitHub</span>
      <ul class="more__list">
        {
          otherRepos.map((r) => (
            <li>
              <a href={r.url} target="_blank" rel="noopener">
                <code>{r.name}</code>
                <span>{r.note}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .feature {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .feature__body,
  .feature__aside {
    border-radius: var(--radius);
    border: 1px solid var(--border);
    padding: clamp(1.4rem, 3vw, 2.25rem);
  }

  .feature__body {
    position: relative;
    overflow: hidden;
    background: var(--bg-elev);
    box-shadow: var(--shadow);
  }

  .feature__tagline {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin-bottom: 0.6rem;
  }

  .feature__tagline::before {
    content: '$ ' / '';
    color: var(--accent);
  }

  .feature__body h3 {
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
  }

  .feature__summary {
    margin-top: 0.9rem;
    color: var(--text-muted);
    font-size: 1.02rem;
    max-width: 60ch;
  }

  .feature__list {
    display: grid;
    gap: 0.55rem;
    margin-top: 1.25rem;
    color: var(--text);
    font-size: 0.95rem;
  }

  .feature__list li {
    position: relative;
    padding-left: 1.35rem;
  }

  .feature__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 8px;
    height: 8px;
    background: var(--accent);
  }

  .feature__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .feature__aside {
    background: var(--bg-soft);
  }

  .feature__aside-title {
    font-weight: 600;
    margin-bottom: 0.9rem;
  }

  .feature__aside ul {
    display: grid;
    gap: 0.55rem;
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .feature__aside li {
    position: relative;
    padding-left: 1.3rem;
  }

  .feature__aside li::before {
    content: '+';
    position: absolute;
    left: 0;
    color: var(--accent-2);
    font-weight: 700;
  }

  .sub-head {
    font-size: 1.35rem;
  }

  .sub-lede {
    margin: 0.4rem 0 1.4rem;
    color: var(--text-muted);
  }

  .card {
    color: inherit;
  }

  .card:hover {
    text-decoration: none;
  }

  .card__top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .card__repo {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-faint);
  }

  .card__repo :global(svg) {
    width: 13px;
    height: 13px;
  }

  .card__summary {
    color: var(--text) !important;
    font-weight: 500;
  }

  .card--wide {
    grid-column: 1 / -1;
  }

  .more {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 1.5rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--border);
  }

  .more__label {
    font-size: 0.85rem;
    color: var(--text-faint);
    white-space: nowrap;
  }

  .more__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }

  .more__list a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .more__list code {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text);
  }

  .eco {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .native {
    display: grid;
    gap: 0.3rem;
    font-size: 0.88rem;
  }

  .native li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 0.75rem;
  }

  .native strong {
    font-weight: 500;
    color: var(--text);
  }

  .native__platforms {
    color: var(--text-faint);
    font-size: 0.8rem;
  }

  .suite {
    display: grid;
    gap: 0.75rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .cat {
    border: 1px solid var(--border);
    background: var(--bg-elev);
  }

  .cat[open] {
    border-color: var(--border-strong);
  }

  .cat summary {
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    padding: 1rem 1.25rem;
    cursor: pointer;
    list-style: none;
  }

  .cat summary::-webkit-details-marker {
    display: none;
  }

  .cat summary::before {
    content: '+' / '';
    color: var(--accent);
    font-weight: 700;
    grid-row: 1;
  }

  .cat[open] summary::before {
    content: '−' / '';
  }

  .cat summary:hover .cat__name {
    color: var(--accent-text);
  }

  .cat__name {
    font-weight: 600;
  }

  .cat__count {
    font-size: 0.8rem;
    color: var(--accent-contrast);
    background: var(--accent);
    padding: 0 0.45rem;
    justify-self: start;
  }

  .cat__desc {
    grid-column: 2 / -1;
    color: var(--text-faint);
    font-size: 0.85rem;
  }

  .apps {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 1px;
    background: var(--border);
    border-top: 1px solid var(--border);
  }

  .apps a {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    height: 100%;
    padding: 0.9rem 1.25rem;
    background: var(--bg-elev);
    color: inherit;
  }

  .apps a:hover {
    text-decoration: none;
    background: var(--bg-soft);
  }

  .apps a:hover .app__name {
    color: var(--accent-text);
  }

  .app__name {
    font-weight: 600;
  }

  .app__summary {
    color: var(--text-muted);
    font-size: 0.88rem;
  }

  .app__instead {
    margin-top: auto;
    padding-top: 0.2rem;
    color: var(--accent-2);
    font-size: 0.78rem;
  }

  @media (min-width: 900px) {
    .feature {
      grid-template-columns: 1.6fr 1fr;
    }
  }
</style>
