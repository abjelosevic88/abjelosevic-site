---
import { Image } from 'astro:assets';
import Icons from './Icons.astro';
import { profile, stats, pocketHomelab } from '../data/site';
import avatar from '../assets/avatar.jpg';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="hero" id="top">
  <div class="hero__bg" aria-hidden="true"></div>
  <div class="container hero__inner">
    <div class="hero__text">
      <a class="hero__badge" href={pocketHomelab.url} target="_blank" rel="noopener">
        <span class="dot" aria-hidden="true"></span>
        Currently building {pocketHomelab.name}
        <Icons name="arrow" />
      </a>

      <h1>{profile.name}</h1>
      <p class="hero__title">{profile.title}</p>
      <p class="hero__tagline">{profile.tagline}</p>

      <div class="hero__cta">
        <a class="btn btn--primary" href="#homelab">
          See the work
          <Icons name="arrow" />
        </a>
        <a class="btn" href={profile.github} target="_blank" rel="noopener">
          <Icons name="github" />
          GitHub
        </a>
        <a class="btn" href={`mailto:${profile.email}`}>
          <Icons name="mail" />
          Email
        </a>
        <a class="btn" href={`${base}${profile.cv}`} download>
          <Icons name="file" />
          CV (PDF)
        </a>
      </div>

      <p class="hero__location">
        <Icons name="pin" />
        {profile.location}
      </p>
    </div>

    <div class="hero__portrait">
      <div class="portrait">
        <Image src={avatar} alt={`Portrait of ${profile.name}`} width="360" height="360" densities={[1, 2]} loading="eager" fetchpriority="high" />
      </div>
    </div>
  </div>

  <div class="container">
    <ul class="stats reveal">
      {
        stats.map((s) => (
          <li>
            <strong>{s.value}</strong>
            <span>{s.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 8vw, 6rem) clamp(2.5rem, 6vw, 4rem);
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(60% 50% at 80% 10%, var(--glow-1), transparent 70%),
      radial-gradient(45% 40% at 15% 85%, var(--glow-2), transparent 70%),
      linear-gradient(to bottom, transparent, var(--bg));
    mask-image: linear-gradient(to bottom, black 70%, transparent);
  }

  .hero__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--border) 1px, transparent 1px),
      linear-gradient(to bottom, var(--border) 1px, transparent 1px);
    background-size: 32px 32px;
    opacity: 0.6;
    mask-image: radial-gradient(70% 60% at 50% 30%, black, transparent);
  }

  .hero__inner {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.9rem 0.4rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-elev);
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 500;
    margin-bottom: 1.5rem;
    transition: border-color 0.2s var(--ease), color 0.2s var(--ease);
  }

  .hero__badge:hover {
    text-decoration: none;
    color: var(--text);
    border-color: var(--accent);
  }

  .hero__badge :global(svg) {
    width: 14px;
    height: 14px;
  }

  .dot {
    width: 8px;
    height: 8px;
    background: var(--accent-2);
  }

  h1 {
    font-size: clamp(2.2rem, 5.5vw, 3.6rem);
    letter-spacing: -0.01em;
  }

  /* Blinking cursor after the name. */
  h1::after {
    content: "_" / "";
    color: var(--accent);
    animation: blink 1s steps(2) infinite;
  }

  @keyframes blink {
    to {
      opacity: 0;
    }
  }

  .hero__title {
    margin-top: 0.75rem;
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    font-weight: 550;
    color: var(--accent-text);
  }

  .hero__tagline {
    margin-top: 1rem;
    max-width: 54ch;
    font-size: clamp(1.02rem, 1.6vw, 1.18rem);
    color: var(--text-muted);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }

  .hero__location {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 1.25rem;
    font-size: 0.9rem;
    color: var(--text-faint);
  }

  .hero__location :global(svg) {
    width: 15px;
    height: 15px;
  }

  .hero__portrait {
    display: flex;
    justify-content: center;
  }

  .portrait {
    position: relative;
    width: clamp(180px, 36vw, 300px);
    aspect-ratio: 1;
    padding: 2px;
    background: var(--accent);
    /* Offset block behind the frame, like a terminal window shadow. */
    box-shadow: 8px 8px 0 var(--bg-soft), 8px 8px 0 1px var(--border-strong);
  }

  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--bg-soft);
    filter: grayscale(1) contrast(1.1);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--border);
    overflow: hidden;
  }

  .stats li {
    display: grid;
    gap: 0.2rem;
    padding: 1.1rem 1.25rem;
    background: var(--bg-elev);
  }

  .stats strong {
    font-size: 1.35rem;
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .stats span {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  @media (min-width: 760px) {
    .hero__inner {
      grid-template-columns: 1.4fr 1fr;
    }

    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
